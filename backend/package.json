{
  "name": "k-mestre-ai-backend",
  "version": "0.1.0",
  "description": "K-Mestre - backend",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 -r ts-node/register src/*.test.ts",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "create-user": "ts-node src/scripts/create-user.ts",
    "postinstall": "prisma generate && prisma generate --schema prisma/schema.postgres.prisma",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "Gabriel Kramer Mota",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "@types/ws": "^8.18.1",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
